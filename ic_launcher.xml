// ============================================
// PANTALLA PRINCIPAL - HOME
// ============================================

@Composable
fun HomeScreen(navController: NavController) {
    Box(modifier = Modifier.fillMaxSize()) {

        // Contenido scrolleable
        LazyColumn(
            modifier = Modifier.fillMaxSize(),
            contentPadding = PaddingValues(bottom = 100.dp) // Espacio para la barra inferior
        ) {
            item { TopBar() }
            item { SectionTitle("Ofertas del día") }
            item { Spacer(modifier = Modifier.height(16.dp)) }
            item { OffersCarousel() }
            item { Spacer(modifier = Modifier.height(16.dp)) }
            item { Banner() }
            item { Spacer(modifier = Modifier.height(16.dp)) }
            item { CategoriesSection() }
            item { Spacer(modifier = Modifier.height(16.dp)) }
            item { SectionTitle("Productos destacados") }
            item { ProductsCarousel() }
        }

        // Barra de navegación inferior (siempre visible abajo)
        BottomNav(
            navController = navController,
            modifier = Modifier.align(Alignment.BottomCenter)
        )
    }
}

// ============================================
// BARRA SUPERIOR CON BÚSQUEDA
// ============================================

@Composable
fun TopBar() {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .padding(8.dp),
        verticalAlignment = Alignment.CenterVertically
    ) {
        // Logo
        Image(
            painter = painterResource(R.drawable.ic_launcher_foreground),
            contentDescription = "Logo",
            modifier = Modifier.size(48.dp)
        )

        // Campo de búsqueda
        SearchField(
            label = "Buscar...",
            modifier = Modifier
                .weight(1f)
                .padding(horizontal = 8.dp)
        )

        // Menú hamburguesa
        Image(
            painter = painterResource(R.drawable.ic_launcher_foreground),
            contentDescription = "Menú",
            modifier = Modifier
                .size(48.dp)
                .clickable { /* TODO: Abrir menú lateral */ }
        )
    }
}

@Composable
fun SearchField(label: String, modifier: Modifier = Modifier) {
    var search by remember { mutableStateOf("") }

    TextField(
        value = search,
        onValueChange = { search = it },
        label = { Text(text = label) },
        singleLine = true,
        modifier = modifier
    )
}

// ============================================
// CARRUSEL DE OFERTAS (LazyRow horizontal)
// ============================================

@Composable
fun OffersCarousel() {
    LazyRow(
        contentPadding = PaddingValues(horizontal = 16.dp),
        horizontalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        items(4) { index ->
            OfferCard(offerNumber = index + 1)
        }
    }
}

@Composable
fun OfferCard(offerNumber: Int) {
    Card(
        modifier = Modifier
            .width(120.dp)
            .height(80.dp)
    ) {
        Box(
            modifier = Modifier.fillMaxSize(),
            contentAlignment = Alignment.Center
        ) {
            Text(
                text = "Oferta $offerNumber",
                fontWeight = FontWeight.Bold
            )
        }
    }
}

// ============================================
// BANNER PROMOCIONAL
// ============================================

@Composable
fun Banner() {
    Card(
        modifier = Modifier
            .fillMaxWidth()
            .height(150.dp)
            .padding(horizontal = 16.dp),
        shape = RectangleShape
    ) {
        Box(
            modifier = Modifier
                .fillMaxSize()
                .background(Color.LightGray),
            contentAlignment = Alignment.Center
        ) {
            Text(
                text = "BANNER PROMOCIONAL",
                fontSize = 20.sp,
                fontWeight = FontWeight.Bold
            )
        }
    }
}

// ============================================
// SECCIÓN DE CATEGORÍAS (con botón Liga)
// ============================================

@Composable
fun CategoriesSection() {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .padding(horizontal = 16.dp),
        horizontalArrangement = Arrangement.SpaceEvenly
    ) {
        // Categoría 1
        CategoryItem(icon = R.drawable.ic_launcher_foreground, name = "Mascotas")

        // Categoría 2
        CategoryItem(icon = R.drawable.ic_launcher_foreground, name = "Accesorios")

        // Botón especial "La Liga" (más grande y redondo)
        LigaButton()
    }
}

@Composable
fun CategoryItem(icon: Int, name: String) {
    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Image(
            painter = painterResource(icon),
            contentDescription = name,
            modifier = Modifier.size(60.dp)
        )
        Text(text = name, fontSize = 12.sp)
    }
}

@Composable
fun LigaButton() {
    FloatingActionButton(
        onClick = { /* TODO: Navegar a PartidosLiga */ },
        containerColor = Color.Red,
        shape = CircleShape,
        modifier = Modifier.size(80.dp)
    ) {
        Text(
            text = "La\nLiga\nGratis",
            color = Color.White,
            fontWeight = FontWeight.Bold,
            textAlign = TextAlign.Center,
            fontSize = 12.sp
        )
    }
}

// ============================================
// CARRUSEL DE PRODUCTOS
// ============================================

@Composable
fun ProductsCarousel() {
    LazyRow(
        contentPadding = PaddingValues(horizontal = 16.dp),
        horizontalArrangement = Arrangement.spacedBy(16.dp)
    ) {
        items(5) { index ->
            ProductCard(productNumber = index + 1)
        }
    }
}

@Composable
fun ProductCard(productNumber: Int) {
    Card(
        modifier = Modifier.width(150.dp)
    ) {
        Column(horizontalAlignment = Alignment.CenterHorizontally) {
            Image(
                painter = painterResource(R.drawable.ic_launcher_foreground),
                contentDescription = "Producto $productNumber",
                modifier = Modifier
                    .height(120.dp)
                    .fillMaxWidth()
            )
            Text(
                text = "Producto $productNumber",
                modifier = Modifier.padding(8.dp),
                fontWeight = FontWeight.Bold
            )
            Text(
                text = "10.99€",
                color = Color.Green,
                modifier = Modifier.padding(bottom = 8.dp)
            )
        }
    }
}

// ============================================
// TÍTULO DE SECCIÓN REUTILIZABLE
// ============================================

@Composable
fun SectionTitle(title: String) {
    Text(
        text = title,
        modifier = Modifier.padding(horizontal = 16.dp, vertical = 8.dp),
        fontSize = 20.sp,
        fontWeight = FontWeight.Bold
    )
}

// ============================================
// BARRA DE NAVEGACIÓN INFERIOR
// ============================================

@Composable
fun BottomNav(navController: NavController, modifier: Modifier = Modifier) {
    Row(
        modifier = modifier
            .fillMaxWidth()
            .height(70.dp)
            .background(Color.Gray)
            .padding(horizontal = 16.dp),
        horizontalArrangement = Arrangement.SpaceAround,
        verticalAlignment = Alignment.CenterVertically
    ) {
        // Home (pantalla actual)
        NavItem(
            icon = R.drawable.ic_launcher_foreground,
            label = "Home",
            onClick = { /* Ya estamos en Home */ }
        )

        // Productos vistos
        NavItem(
            icon = R.drawable.ic_launcher_foreground,
            label = "Vistos",
            onClick = { navController.navigate("history") }
        )

        // Carrito
        NavItem(
            icon = R.drawable.ic_launcher_foreground,
            label = "Carrito",
            onClick = { navController.navigate("cart") }
        )

        // Perfil
        NavItem(
            icon = R.drawable.ic_launcher_foreground,
            label = "Perfil",
            onClick = { navController.navigate("profile") }
        )

        NavItem(
            icon = R.drawable.ic_launcher_foreground,
            label = "Mascota",
            onClick = { navController.navigate("mascot") }
        )
    }
}

@Composable
fun NavItem(icon: Int, label: String, onClick: () -> Unit) {
    Column(
        horizontalAlignment = Alignment.CenterHorizontally,
        modifier = Modifier.clickable(onClick = onClick)
    ) {
        Image(
            painter = painterResource(icon),
            contentDescription = label,
            modifier = Modifier.size(32.dp)
        )
        Text(text = label, fontSize = 12.sp, color = Color.White)
    }
}

