@Preview(showBackground = true, showSystemUi = true)
@Composable
fun PartidosLigaScreenPreview() {
    MaterialTheme {
        PartidosLigaScreen(navController = rememberNavController())
    }
}

@Preview(showBackground = true)
@Composable
fun PartidoCardPreview() {
    MaterialTheme {
        PartidoCard(
            partido = Partido(
                equipoLocal = "Real Madrid",
                equipoVisitante = "Barcelona",
                hora = "20:00",
                liga = "La Liga"
            )
        )
    }
}